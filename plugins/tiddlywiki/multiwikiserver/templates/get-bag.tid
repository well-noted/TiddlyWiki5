title: $:/plugins/tiddlywiki/multiwikiserver/templates/get-bag

\define renderPagination()
<$vars pageSize="50">
<$let 
    currentPage={{$:/temp/mws/currentPage}}
    currentPageNum={{{ [<currentPage>!is[blank]else[1]] }}}
    startIndex={{{ [<currentPageNum>subtract[1]multiply<pageSize>] }}}
    totalTiddlers={{{ [<bag-titles>jsonget[]count[]] }}}
    pageCount={{{ [<totalTiddlers>divide<pageSize>ceil[]] }}}
>
<div class="pagination-controls">
    <div>Page <<currentPageNum>> of <<pageCount>></div>
    <div class="pagination-buttons">
        <$button disabled={{{ [<currentPageNum>match[1]] }}}
            class="tc-btn-invisible"
            set="$:/temp/mws/currentPage"
            setTo={{{ [<currentPageNum>subtract[1]] }}}>Previous</$button>
        <$button disabled={{{ [<currentPageNum>match<pageCount>] }}}
            class="tc-btn-invisible"
            set="$:/temp/mws/currentPage"
            setTo={{{ [<currentPageNum>add[1]] }}}>Next</$button>
    </div>
</div>
</$let>
</$vars>
\end

\define renderTiddlerList()
<$vars pageSize="50">
<$let 
    currentPage={{$:/temp/mws/currentPage}}
    currentPageNum={{{ [<currentPage>!is[blank]else[1]] }}}
    startIndex={{{ [<currentPageNum>subtract[1]multiply<pageSize>] }}}
>
<div class="tiddler-list">
    <$list filter="[<bag-titles>jsonget[]sort[]rest<startIndex>first<pageSize>]">
    <div class="tiddler-entry">
        <input type="checkbox" name="selected_tiddlers" value=<<currentTiddler>>/>
        <$link to=<<currentTiddler>>><<currentTiddler>></$link>
    </div>
    </<$list>
</div>
</$let>
</$vars>
\end

! <img src=`/bags/${ [<bag-name>encodeuricomponent[]] }$/tiddlers/%24%3A%2Ffavicon.ico?fallback=/.system/missing-favicon.png` class="mws-favicon-small" width="32px"/> 
Bag <$text text={{{ [<bag-name>]}}}/>

<!-- Import form -->
<form method="post" action="tiddlers/" enctype="multipart/form-data">
    <div>
        <label>Files to upload:</label>
        <input type="file" name="files-to-upload" accept="*/*" multiple />
    </div>
    <div>
        <label>Tiddler tags:</label>
        <input type="text" name="tiddler-field-tags" />
    </div>
    <div>
        <input type="submit" value="Upload"/>
    </div>
</form>

<!-- Filter input -->
<div class="filter-section">
    <form method="GET">
        <label>Filter tiddlers:</label>
        <select name="field">
            <option value="title" selected={{{ [<current-field>match[title]then[selected]] }}}>Title</option>
            <option value="tag" selected={{{ [<current-field>match[tag]then[selected]] }}}>Tags</option>
            <option value="text" selected={{{ [<current-field>match[text]then[selected]] }}}>Text</option>
        </select>
        <input type="text" name="filter" value=<<current-filter>> placeholder="Enter search term..."/>
        <input type="submit" value="Filter"/>
        <a href={{{ [<bag-name>addprefix[/bags/]addsuffix[/]] }}} class="button">Show All</a>
    </form>
</div>

<!-- Move tiddlers form -->
<form action="tiddlers/" method="post" class="mws-form" enctype="multipart/form-data">
    <div class="mws-form-heading">Move Selected Tiddlers</div>
    <input type="hidden" name="operation" value="move"/>
    <input type="hidden" name="source-bag" value=<<bag-name>>/>

    <div class="checkbox-controls">
        <a href="javascript:document.querySelectorAll('input[name=\'selected_tiddlers\']').forEach(cb => cb.checked = true)" class="button">Select All</a>
        <a href="javascript:document.querySelectorAll('input[name=\'selected_tiddlers\']').forEach(cb => cb.checked = false)" class="button">Deselect All</a>
    </div>

    <!-- Encapsulate the pagination and tiddler list to isolate their variables -->
    <$set name="localScope" filter="[all[current]]">
        <<renderPagination>>
        <<renderTiddlerList>>
    </$set>

    <div class="mws-form-field">
        <label>Target Bag</label>
        <select name="bag-name" required>
            <$list filter="[<bag-list>jsonindexes[]]">
                <$let bag-info={{{ [<bag-list>jsonextract<currentTiddler>] }}} bag-name={{{ [<bag-info>jsonget[bag_name]] }}}>
                    <option value=<<bag-name>>><$text text=<<bag-name>>/></option>
                </$let>
            </$list>
        </select>
    </div>
    
    <div class="mws-form-buttons">
        <input type="submit" value="Move Selected"/>
    </div>
</form>

<style>
.bag-selector {
    margin: 15px 0;
    padding: 15px;
    background-color: #f8f8f8;
    border-radius: 4px;
}

.bag-selector label {
    display: block;
    margin-bottom: 5px;
    font-weight: bold;
}

